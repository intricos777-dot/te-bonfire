{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "game": { "type": "string" },
    "description": { "type": "string" },
    "mounts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": { "type": "string" },
          "role": { "type": "string" },
          "path": { "type": "string" },
          "required": { "type": "boolean" }
        },
        "required": ["id", "role", "path"]
      }
    }
  },
  "required": ["game", "mounts"]
}
